# TruthLens AI - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# AI API Keys (Optional - Intelligent Demo & NLP Engine activates automatically if omitted)
# Google Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key: https://platform.openai.com/
OPENAI_API_KEY=

# News API Key (Optional - Curated verified news stream is provided if omitted)
NEWS_API_KEY=

# Demo Mode default
DEMO_MODE=true
